generator client {
  provider               = "prisma-client-js"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id         String  @id @default(cuid())
  name       String
  logoUrl    String?
  fontFamily String  @default("Raleway")

  profiles Profile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id              String  @id @default(cuid())
  publicId        String  @unique
  shortCode       String  @unique
  fullName        String
  jobTitle        String?
  email           String?
  websiteUrl      String?
  phone           String?
  photoUrl        String?
  logoUrl         String?
  fontFamily      String?
  buttonColor     String?
  bodyTextColor   String  @default("#101d3b")
  backgroundColor String  @default("#ffffff")
  buttonTextColor String  @default("#ffffff")
  saveContactButtonColor     String @default("#101d3b")
  saveContactButtonTextColor String @default("#ffffff")
  socialLinkBackgroundColor  String @default("#f1f3f7")
  socialLinkIconColor        String @default("#14213f")
  pdfUrl          String?
  visitCount      Int     @default(0)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  socialLinks SocialLink[]
  visits      ProfileVisit[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  claimTokens ProfileClaimToken[]

  @@unique([userId])
}

model ProfileVisit {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([profileId, createdAt])
}

model SocialLink {
  id        String @id @default(cuid())
  platform  String
  url       String
  sortOrder Int    @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         Role   @default(CUSTOMER)

  profiles Profile[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
}

model ProfileClaimToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

enum Role {
  ADMIN
  CUSTOMER
}
