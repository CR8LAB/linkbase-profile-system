DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
MVP_DATABASE_URL="postgresql://USER:PASSWORD@MVP-BRANCH-HOST:5432/DATABASE?sslmode=require"
# Generate a unique key with the command in docs/deployment.md.
# Set JWT_SECRET to the generated base64url:... or hex:... value; do not commit it.
JWT_SECRET=
PORT=5000
GCS_BUCKET_NAME="your-google-cloud-storage-bucket"
# Use explicit HTTPS origins in production. Local development uses localhost HTTP.
FRONTEND_ORIGINS="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LinkBase <no-reply@example.com>"
